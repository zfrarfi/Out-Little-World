# ============================================================
# OUR LITTLE WORLD — Environment Variables Template
# ============================================================
# Mendukung 2 mode sekaligus:
#   A) Lokal di laptop memakai XAMPP + phpMyAdmin
#   B) Online publik di Vercel + MySQL Cloud (TiDB Cloud / Aiven / Railway)

# --- 1. Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 2A. Database MySQL Lokal (XAMPP / phpMyAdmin) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=our_little_world
# Set MYSQL_SSL=true jika pakai Cloud MySQL (otomatis true untuk host non-localhost)
MYSQL_SSL=false

# --- 2B. ATAU 1 Baris DATABASE_URL (Untuk Vercel + TiDB Cloud / Aiven / Railway) ---
# Jika diisi, DATABASE_URL otomatis dipakai menggantikan MYSQL_HOST di atas.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/our_little_world

# --- 3. Driver Penyimpanan Media ---
# Otomatis 'local' di XAMPP, dan otomatis 'database' (MySQL LONGBLOB) di Vercel
# agar foto/media permanen dan bisa diakses pasangan dari seluruh dunia!
# STORAGE_DRIVER=database

# --- 4. Rahasia Sesi Login (acak minimal 32 karakter) ---
AUTH_SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# --- 5. AI Love Assistant API (Opsional — tanpa ini Mode Lokal tetap jalan 100%) ---
# Google Gemini gratis: https://generativelanguage.googleapis.com/v1beta/openai | gemini-2.0-flash
# Groq gratis:          https://api.groq.com/openai/v1 | llama-3.3-70b-versatile
# OpenAI:               https://api.openai.com/v1 | gpt-4o-mini
AI_API_KEY=
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.0-flash
