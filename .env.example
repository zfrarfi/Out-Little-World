# ============================================================
# OUR LITTLE WORLD — Environment Variables Template (XAMPP MySQL)
# ============================================================
# Salin file ini menjadi `.env.local` (sudah dibuat otomatis
# dengan default XAMPP: user=root, password kosong).

# --- 1. Application URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- 2. Database MySQL (XAMPP / phpMyAdmin) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=our_little_world

# --- 3. Rahasia Sesi Login (acak minimal 32 karakter) ---
AUTH_SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# --- 4. AI Love Assistant API (Opsional, server-only) ---
# Contoh OpenAI:      https://api.openai.com/v1  | model: gpt-4o-mini
# Contoh OpenRouter:  https://openrouter.ai/api/v1 | model: openai/gpt-4o-mini
# Contoh Groq:        https://api.groq.com/openai/v1 | model: llama-3.3-70b-versatile
# Contoh Gemini:      https://generativelanguage.googleapis.com/v1beta/openai | model: gemini-2.0-flash
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
